# Copy to .env to override defaults (docker compose reads .env automatically;
# for local runs, export these variables in your shell).

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=weather-stream

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=weather_pipeline

# Producer: seconds between Open-Meteo API polls (minimum 15)
PRODUCER_INTERVAL_SECONDS=60
# Cities to monitor as Name:lat:lon, comma-separated (leave empty for the 5 default Philippine cities)
CITIES=

# Spark
SPARK_AGG_WINDOW=5 minutes
SPARK_WATERMARK=15 minutes
SPARK_CHECKPOINT_DIR=./checkpoints

# Dashboard
DISPLAY_TIMEZONE=Asia/Manila
LIVE_REFRESH_SECONDS=15
